{
  "info": {
    "_postman_id": "f5e937d1-92b0-4a87-b6f1-a1e1279a4055",
    "name": "SupplyBridge — B2B Manual API Testing Portfolio",
    "description": "Manual and scripted API testing collection for the SupplyBridge B2B Supplier Order & Inventory AUT. Covers customer inquiries, catalog checks, order placement, lifecycle state transitions, idempotency, multi-tenant security, and inventory restoration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Customer APIs",
      "item": [
        {
          "name": "Get All Customers [REQ-001]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/customers",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Retrieves the registered B2B corporate customer list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains customers array\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Customer By ID - Active [REQ-001]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "{{customer_id}}"]
            },
            "description": "Retrieves details for a specific active customer account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Customer ID matches request\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(parseInt(pm.environment.get(\"customer_id\")));",
                  "    pm.expect(json.data.status).to.eql(\"ACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Customer By ID - Not Found [REQ-001]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/customers/9999",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "customers", "9999"]
            },
            "description": "Negative check for non-existent customer ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error format validation\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.message).to.eql(\"RESOURCE_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Product and Inventory APIs",
      "item": [
        {
          "name": "Get All Products Catalog [REQ-002]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Retrieves the product catalog including SKU and available stock."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Catalog contains items with valid prices and stock\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    json.data.forEach(function(item) {",
                  "        pm.expect(item.unitPrice).to.be.above(0);",
                  "        pm.expect(item.availableStock).to.be.at.least(0);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Product By ID [REQ-002]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            },
            "description": "Inspect stock and price for a specific product ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Product ID matches\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(parseInt(pm.environment.get(\"product_id\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Adjust Product Stock - Restock [REQ-004]",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"stockChange\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}/stock",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}", "stock"]
            },
            "description": "Warehouse stock replenishment endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Stock successfully adjusted\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Order Management APIs",
      "item": [
        {
          "name": "Create Order - Valid Data [REQ-004, REQ-005, TC-001]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 5,\n    \"idempotencyKey\": \"test-idem-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Places a wholesale purchase order for an authorised customer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Total calculation is mathematically accurate\", function () {",
                  "    var expectedTotal = Number((json.data.unitPrice * json.data.quantity).toFixed(2));",
                  "    pm.expect(json.data.totalAmount).to.eql(expectedTotal);",
                  "});",
                  "pm.test(\"Order status is CONFIRMED\", function () {",
                  "    pm.expect(json.data.status).to.eql(\"CONFIRMED\");",
                  "});",
                  "if (json.data && json.data.id) {",
                  "    pm.environment.set(\"new_order_id\", json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Order By ID - Success [REQ-006, TC-002]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{new_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{new_order_id}}"]
            },
            "description": "Fetches created order details."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Retrieved order ID matches requested ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(parseInt(pm.environment.get(\"new_order_id\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Orders by Customer ID [REQ-006, TC-025]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/customer/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "customer", "{{customer_id}}"]
            },
            "description": "Retrieves the list of orders belonging to the authenticated customer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned orders belong to Customer ID\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(o) {",
                  "        pm.expect(o.customerId).to.eql(parseInt(pm.environment.get(\"customer_id\")));",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Order and Restore Stock [REQ-007, TC-013]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{new_order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{new_order_id}}", "cancel"]
            },
            "description": "Cancels a CONFIRMED order and automatically restores allocated warehouse stock."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Order status is CANCELLED\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql(\"CANCELLED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Order Status Transition [REQ-008]",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{order_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{order_id}}", "status"]
            },
            "description": "Updates lifecycle state of an eligible order."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 422 if already completed\", function () {",
                  "    pm.expect([200, 422]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Authentication and Negative Scenarios",
      "item": [
        {
          "name": "Missing Authentication Header [REQ-009, TC-010]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Sends order request without X-API-KEY header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid Authentication Token [REQ-009]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "sb_invalid_token_99999"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Sends order request with unrecognized token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cross-Tenant Access Rejection [REQ-009, TC-011]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/3",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "3"]
            },
            "description": "Customer 1 attempts to retrieve Order 3 which belongs to Customer 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Error message is FORBIDDEN\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.eql(\"FORBIDDEN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Insufficient Inventory Order Rejection [REQ-003, TC-009]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 99999\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Submits order exceeding available inventory."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Error specifies insufficient inventory\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.eql(\"BUSINESS_RULE_VIOLATION\");",
                  "    pm.expect(json.errors[0]).to.include(\"Insufficient inventory\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Zero or Negative Quantity Rejection [REQ-005, TC-007]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 0\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Submits quantity 0."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Duplicate Submission with Idempotency Key [REQ-010, TC-014]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": 1,\n    \"quantity\": 2,\n    \"idempotencyKey\": \"duplicate-check-idem-key\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Idempotency key prevents duplicate order creations on retry."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Idempotency key preserved in order\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.idempotencyKey).to.eql(\"duplicate-check-idem-key\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - End-to-End Workflows",
      "item": [
        {
          "name": "E2E Step 1: Query Product Initial Stock [TC-028]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            },
            "description": "Captures initial available stock."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Product retrieved with stock\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"e2e_initial_stock\", json.data.availableStock);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E2E Step 2: Place Purchase Order [TC-028]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": {{customer_id}},\n    \"productId\": {{product_id}},\n    \"quantity\": 5,\n    \"idempotencyKey\": \"e2e-order-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Places an order for 5 units."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.environment.set(\"e2e_order_id\", json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E2E Step 3: Verify Stock Decrement [TC-028]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            },
            "description": "Verifies warehouse stock decreased by 5 units."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Stock decreased by exactly ordered quantity\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    var initial = parseInt(pm.environment.get(\"e2e_initial_stock\"));",
                  "    pm.expect(json.data.availableStock).to.eql(initial - 5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E2E Step 4: Cancel Order & Restore Stock [TC-028]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-KEY",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders/{{e2e_order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "orders", "{{e2e_order_id}}", "cancel"]
            },
            "description": "Cancels order and triggers stock restoration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order cancelled\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.status).to.eql(\"CANCELLED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
